theme
{
	name = "modern"

	view = view.small

	background
	{
		color = #161217
		opacity = 100
		// effect = 2
	}

	item
	{
		opacity = 100
		radius = 0
		prefix = 1

		text
		{
			normal = #eae0e7
			select = #eae0e7
			normal-disabled = #cfc3cd7a
			select-disabled = #eae0e77a
		}

		back
		{
			select = #e5b6f27a
			select-disabled = #e5b6f22b
		}
	}

	font
	{
		size = 16
		name = "JetBrainsMono NFP"
		weight = 1
		italic = 0
	 }

	border
	{
		enabled = false
		size = 2
		color = #e5b6f27a
		opacity = 100
		radius = 0
	}

	shadow
	{
		enabled = true
		size = 5
		opacity = 5
		color = #110d12
	}

	separator
	{
		size = 1
		color = #231e23
	}

	symbol
	{
		normal = #e5b6f2
		select = #eae0e7
		normal-disabled = #cfc3cd7a
		select-disabled = #cfc3cd7a
	}

	image
	{
		enabled = false
		color = [#e5b6f2, #e5b6f2, #e5b6f2]
	}
}
