{
  "animation": {
    "enabled": true,
    "duration": 180,
    "fps": 144,
    "style": "EaseOutCubic",
    "workspace": {
      "kind": "SlideFade",
      "duration": 600,
      "bezier": [0.22, 1, 0.36, 1],
      "backdrop_blur": false,
      "backdrop_blur_radius": 30,
      "shadow": false,
      "border": null
    },
    "windows": {
      "duration": 120,
      "bezier": [0.22, 1, 0.36, 1]
    }
  },
  "app_specific_configuration_path": "$Env:USERPROFILE/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 5,
  "default_container_padding": 3,
  "transparency": true,
  "transparency_alpha": 400,
  "border": false,
  "border_width": 8,
  "border_offset": -1,
  "theme": {
    "palette": "Base16",
    "name": "Ashes",
    "bar_accent": "Base0D"
  },
  "monitors": [
    {
      "workspaces": [
        {
          "name": "I",
          "layout": "BSP"
        },
        {
          "name": "II",
          "layout": "BSP"
        },
        {
          "name": "III",
          "layout": "Scrolling"
        },
        {
          "name": "IV",
          "layout": "Scrolling"
        },
        {
          "name": "V",
          "layout": "Scrolling"
        },
        {
          "name": "VI",
          "layout": "BSP"
        },
        {
          "name": "VII",
          "layout": "BSP"
        }
      ]
    }
  ]
}